    const blackColumnFill = "rgba(0, 0, 0, 0.9)";
    const blackColumnBorder = "#ffffff33";
    const moveSeries = {
      white: [],
      black: []
    };
    const totalSeries = {
      white: [],
      black: []
    };
    const labels = [];
    const logC = Math.pow(Math.log(3), 2);
    ctrl.steps.forEach((step2, ply) => {
      const turn = ply + 1 >> 1;
      const color = (ply & 1) === 1 ? 0 : 1;
      const colorName = color ? "black" : "white";
      if (ply === 0) {
        return;
      }
      if (ply <= 2) {
        step2.movetime = 0;
      } else {
        step2.movetime = ply % 2 === 1 ? ctrl.steps[ply - 2]?.clocks[WHITE] - (ctrl.steps[ply]?.clocks[WHITE] - ctrl.inc * 1e3) : ctrl.steps[ply - 2]?.clocks[BLACK] - (ctrl.steps[ply]?.clocks[BLACK] - ctrl.inc * 1e3);
      }
      const y3 = Math.pow(Math.log(5e-3 * Math.min(step2.movetime, 12e4) + 3), 2) - logC;
      maxMove = Math.max(y3, maxMove);
      let label = turn + (color ? ". " : "... ") + step2.san;
      const movePoint = {
        name: label,
        x: ply,
        y: color ? -y3 : y3
      };
      moveSeries[colorName].push(movePoint);
      let clock = step2.clocks[color];
      if (clock !== void 0) {
        label += "<br />" + formatClock(clock);
        maxTotal = Math.max(clock, maxTotal);
        totalSeries[colorName].push({
          name: label,
          x: ply,
          y: color ? -clock : clock
        });
      }
      labels.push(label);
    });
    const clickableOptions = {
      cursor: "pointer",
      events: {
        click: function(event) {
          if (event.point) {
            event.point.select();
            selectMove2(ctrl, event.point.x);
          }
        }
      }
    };
    const foregrondLineOptions = {
      ...clickableOptions,
      color: highlightColor,
      lineWidth: 2,
      states: {
        hover: {
          lineWidth: 2
        }
      },
      marker: {
        radius: 1,
        states: {
          hover: {
            radius: 3,
            lineColor: highlightColor,
            fillColor: "white"
          },
          select: {
            radius: 4,
            lineColor: highlightColor,
            fillColor: "white"
          }
        }
      }
    };
    ctrl.movetimeChart = import_highcharts2.default.chart("chart-movetime", {
      chart: {
        type: "column",
        alignTicks: false,
        spacing: [2, 0, 2, 0],
        animation: false,
        backgroundColor: void 0,
        plotShadow: false
      },
      credits: { enabled: false },
      legend: { enabled: false },
      title: { text: void 0 },
      plotOptions: {
        series: {
          animation: false,
          shadow: false
        },
        area: {
          ...foregrondLineOptions,
          trackByArea: true,
          color: highlightColor,
          fillColor: whiteAreaFill,
          negativeFillColor: blackAreaFill,
          events: {
            click: function(event) {
              if (event.point) {
                event.point.select();
                selectMove2(ctrl, event.point.x);
              }
            }
          }
        },
        line: foregrondLineOptions,
        column: {
          color: whiteColumnFill,
          negativeColor: blackColumnFill,
          grouping: false,
          groupPadding: 0,
          pointPadding: 0,
          states: {
            hover: { enabled: false },
            select: {
              enabled: false,
              color: highlightColor,
              borderColor: highlightColor
            }
          }
        }
      },
      tooltip: {
        pointFormatter: function(format) {
          format = format.replace("{series.name}", "");
          const self2 = this;
          const step2 = ctrl.steps[self2.x];
          const movetime = step2?.movetime;
          if (movetime === void 0) return "";
          else return format.replace("{point.y}", (movetime / 1e3).toFixed(1) + "s");
        }
      },
      xAxis: {
        title: { text: void 0 },
        labels: { enabled: false },
        gridLineWidth: 1,
        lineWidth: 0,
        tickWidth: 0
      },
      yAxis: [
        {
          title: { text: null },
          labels: { enabled: false },
          alternateGridColor: void 0,
          min: -maxMove,
          max: maxMove,
          gridLineWidth: 0,
          plotLines: [{
            color: xAxisColor,
            width: 1,
            value: 0,
            zIndex: 10
          }]
        },
        {
          title: { text: null },
          min: -maxTotal,
          max: maxTotal,
          labels: { enabled: false },
          gridLineWidth: 0
        }
      ],
      series: [
        {
          name: "White Clock Area",
          type: "area",
          yAxis: 1,
          data: totalSeries.white
        },
        {
          name: "Black Clock Area",
          type: "area",
          yAxis: 1,
          data: totalSeries.black
        },
        {
          name: "White Move Time",
          type: "column",
          yAxis: 0,
          data: moveSeries.white,
          borderColor: whiteColumnBorder
        },
        {
          name: "Black Move Time",
          type: "column",
          yAxis: 0,
          data: moveSeries.black,
          borderColor: blackColumnBorder
        },
        {
          name: "White Clock Line",
          type: "line",
          yAxis: 1,
          data: totalSeries.white
        },
        {
          name: "Black Clock Line",
          type: "line",
          yAxis: 1,
          data: totalSeries.black
        }
      ]
    });
  }
  var formatClock = (movetime) => {
    return (movetime / 1e3).toFixed(1) + "s";
  };

  // client/analysisClock.ts
  function renderClocks(ctrl) {
    const isWhiteTurn = ctrl.turnColor === "white";
    const whitePov2 = ctrl.mycolor === "white" && !ctrl.flipped() || ctrl.mycolor === "black" && ctrl.flipped();
    const wclass = whitePov2 ? "bottom" : "top";
    const wtime = ctrl.steps[ctrl.ply]?.clocks[WHITE];
    let wel = document.querySelector(`div.anal-clock.${wclass}`);
    if (wel) {
      wel = patch(wel, h(`div.anal-clock.${wclass}`, ""));
      patch(wel, renderClock(wtime, isWhiteTurn, wclass));
    }
    const bclass = whitePov2 ? "top" : "bottom";
    const btime = ctrl.steps[ctrl.ply]?.clocks[BLACK];
    let bel = document.querySelector(`div.anal-clock.${bclass}`);
    if (bel) {
      bel = patch(bel, h(`div.anal-clock.${bclass}`, ""));
      patch(bel, renderClock(btime, !isWhiteTurn, bclass));
    }
  }
  function renderClock(time, active, cls) {
    return h(
      "div.anal-clock." + cls,
      {
        class: { active }
      },
      clockContent(time)
    );
  }
  function clockContent(time) {
    if (!time && time !== 0) return ["-"];
    const date = new Date(time), millis = date.getUTCMilliseconds(), sep = ":", baseStr = pad2(date.getUTCMinutes()) + sep + pad2(date.getUTCSeconds());
    if (time >= 36e5) return [Math.floor(time / 36e5) + sep + baseStr];
    return time >= 6e4 ? [baseStr] : [baseStr, h("tenths", "." + Math.floor(millis / 100).toString())];
  }
  function pad2(num) {
    return (num < 10 ? "0" : "") + num;
  }


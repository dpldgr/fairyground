        ]),
        h("table.tour-stats-links", [
          h("a.i-dl.icon.icon-download", {
            attrs: {
              href: "/tournament/json/" + this.tournamentId,
              download: "pychess_tournament_" + this.tournamentId + ".json"
            }
          }, _("Download all games in JSON"))
        ])
      ]);
      const el2 = document.getElementById("summarybox");
      if (el2) patch(el2, summary);
    }
    renderPlayers(players) {
      const rows = players.map((player2, index5) => this.playerView(player2, (this.page - 1) * 10 + index5 + 1));
      return rows;
    }
    playerView(player2, index5) {
      if (player2.name === this.visitedPlayer) {
        this.doSend({ type: "get_games", tournamentId: this.tournamentId, player: this.visitedPlayer });
      }
      let fullScore = Math.trunc(player2.score / SCORE_SHIFT);
      if (this.system > 0 && this.variant.name !== "janggi") fullScore = fullScore / 2;
      return h("tr", { on: { click: () => this.onClickPlayer(player2.name) } }, [
        h("td.rank", [player2.paused && !this.completed() ? h("i", { class: { "icon": true, "icon-pause": true } }) : index5]),
        h("td.player", [
          h("span.title", player2.title),
          h("span.name", player2.name),
          h("span", player2.rating)
        ]),
        h("td.sheet", [h("div", player2.points.map((s3) => {
          let score = Array.isArray(s3) ? s3[0] : s3;
          if (this.system > 0 && score !== "*" && score !== "-" && this.variant.name !== "janggi") score = score / 2;
          const pointKlass = this.system > 0 ? ".point" : "";
          const resultKlass = this.system > 0 ? score >= 1 ? ".win" : score === 0.5 ? ".draw" : ".lose" : "";
          if (score === 0.5) score = "\xBD";
          return h(scoreTagNames[(s3[1] || 1) - 1] + pointKlass + resultKlass, [score]);
        }))]),
        h("td.total", [
          h("fire", [player2.fire === 2 && this.tournamentStatus === "started" ? h("i", { class: { "icon": true, "icon-fire": true } }) : ""]),
          h("strong.score", fullScore)
          // h('span.perf', player.perf)
        ])
      ]);
    }
    onClickPlayer(player2) {
      console.log("onClickPlayer()", player2);
      if (this.tournamentStatus === "created") return;
      if (this.completed()) {
        if (this.playerGamesOn && this.visitedPlayer === player2) {
          document.getElementById("summary").style.display = "block";
          document.getElementById("player").style.display = "none";
          this.playerGamesOn = false;
        } else {
          this.doSend({ type: "get_games", tournamentId: this.tournamentId, player: player2 });
          document.getElementById("summary").style.display = "none";
          document.getElementById("player").style.display = "block";
          this.playerGamesOn = true;
          this.visitedPlayer = player2;
        }
      } else {
        this.doSend({ type: "get_games", tournamentId: this.tournamentId, player: player2 });
        if (this.playerGamesOn && this.visitedPlayer === player2) {
          this.renderTopGame();
          document.getElementById("player").style.display = "none";
          this.playerGamesOn = false;
        } else {
          this.renderEmptyTopGame();
          document.getElementById("player").style.display = "block";
          this.playerGamesOn = true;
        }
        this.visitedPlayer = player2;
      }
    }
    renderGames(games) {
      const rows = games.reverse().map((game, index5) => this.gameView(game, games.length - index5));
      return rows;
    }
    result(result3, color) {
      let value = "*";
      switch (result3) {
        case "1-0":
          value = color === "w" ? "1" : "0";
          break;
        case "0-1":
          value = color === "b" ? "1" : "0";
          break;
        case "1/2-1/2":
          value = "\xBD";
          break;
        case "-":
          value = "-";
          break;
      }
      const klass = value === "1" ? ".win" : value === "0" ? ".lose" : "";
      return h(`td.result${klass}`, value);
    }
    gameView(game, index5) {
      if (game.result === "-") {
        return h("tr", [
          h("th", index5),
          h("td.bye", { attrs: { colspan: "3" } }, "Bye"),
          h("td.result", "-")
        ]);
      } else {
        const color = game.color === "w" ? this.variant.colors.first : this.variant.colors.second;
        return h("tr", { on: { click: () => {
          window.open("/" + game.gameId, "_blank", "noopener");
        } } }, [
          h("th", index5),
          h("td.player", [
            h("span.title", game.title),
            h("span.name", game.name)
          ]),
          h("td", game.rating),
          h("td", [
            h("i-side.icon", { class: { [colorIcon(this.variant.name, color)]: true } })
          ]),
          this.result(game.result, game.color)
        ]);
      }
    }
    tSystem(system) {
      switch (system) {
        case 0:
          return _("Arena");
        case 1:
          return _("Round-Robin");
        default:
          return _("Swiss");
      }
    }
    renderStats(msg) {
      const games = msg.games.filter((game) => game.result !== "-");
      const gamesLen = games.length;
      const avgOp = gamesLen ? Math.round(games.reduce((a3, b3) => a3 + b3.rating, 0) / gamesLen) : void 0;
      return [
        h("span.close", {
          on: { click: () => this.onClickPlayer(this.visitedPlayer) },
          attrs: { "data-icon": "j" }
        }),
        h("h2", [
          h("rank", msg.rank + ". "),
          playerInfo3(msg.name, msg.title)
        ]),
        h("table.stats", [
          h("tr", [h("th", _("Performance")), h("td", msg.perf)]),
          h("tr", [h("th", _("Games played")), h("td", gamesLen)]),
          h("tr", [h("th", _("Win rate")), h("td", this.calcRate(msg.nbGames, msg.nbWin))]),
          h("tr", [h("th", _("Average opponent")), h("td", avgOp)]),
          h("tr", [h("th", _("Berserk rate")), h("td", this.calcRate(msg.nbGames, msg.nbBerserk))])
        ])
      ];
    }
    renderEmptyTopGame() {
      patch(document.getElementById("top-game"), h("div#top-game.empty"));
    }
    renderTopGame() {
      if (this.topGame === void 0) return;
      const game = this.topGame;
      const variant2 = VARIANTS[game.variant];
      const elements = [
        h("div.player", [h("user", [h("rank", "#" + game.br), game.b]), h("div#bresult")]),
        h(`div#mainboard.${variant2.boardFamily}.${variant2.pieceFamily}.${variant2.ui.boardMark}`, {
          class: { "with-pockets": !!variant2.pocket },
          on: { click: () => window.location.assign("/" + game.gameId) }
        }, [
          h(`div.cg-wrap.${variant2.board.cg}.mini`, {
            hook: {
              insert: (vnode2) => {
                let lastMove, fen;
                [lastMove, fen] = getLastMoveFen(this.variant.name, game.lastMove, game.fen);
                const cg = Chessground(vnode2.elm, {

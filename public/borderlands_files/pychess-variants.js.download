    }
  };
  var AutoNextSettings = class extends BooleanSettings {
    constructor(ctrl) {
      super("puzzle_autoNext", false);
      this.ctrl = ctrl;
    }
    update() {
      this.ctrl.autoNext = this.value;
    }
    view() {

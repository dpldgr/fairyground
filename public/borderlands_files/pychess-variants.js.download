          case "second":
            return inTheFuture ? ngettext("in %1 second", "in %1 seconds", result3) : ngettext("%1 second ago", "%1 seconds ago", result3);
        }
      }
      val = val / maxLength[unit];
    }
    return "";
  }
  function renderTimeago() {

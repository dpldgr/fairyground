  }
  function rawWinningChances(cp) {
    return 2 / (1 + Math.exp(-4e-3 * cp)) - 1;
  }
  function cpWinningChances(cp) {
    return rawWinningChances(Math.min(Math.max(-1e3, cp), 1e3));

  function view(el2, model2) {
    const variant2 = model2.variant.endsWith("960") ? model2.variant.slice(0, -3) : model2.variant;
    const twoBoards = variant2 ? VARIANTS[variant2].twoBoards : false;
    switch (el2.getAttribute("data-view")) {
      case "about":
        return h("div#main-wrap", aboutView(model2));
      case "level8win":
      case "profile":
        return h("div#profile", profileView(model2));
      case "tv":
      case "round":
        if (twoBoards) {
          return h("div#main-wrap.bug", [h("main.round.bug", roundView2(model2))]);
        } else {
          return h("div#main-wrap", [h("main.round", roundView(model2))]);
        }
      case "embed":
        return h("div", embedView(model2));
      case "analysis":
        if (twoBoards) {
          return h("div#main-wrap.bug", analysisView2(model2));
        } else {
          return h("div#main-wrap", analysisView(model2));
          ;
        }
      case "puzzle":
        return h("div#main-wrap", puzzleView(model2));
      case "invite":
        return h("div#main-wrap", inviteView(model2));
      case "editor":
        return h("div#main-wrap", editorView(model2));
      case "tournament":
        return h("div#main-wrap", [h("main.tour", tournamentView(model2))]);
      case "calendar":
        return h("div#calendar", calendarView());
      case "games":
        return h("div", renderGames(model2));
      case "paste":
        return h("div#main-wrap", pasteView(model2));
      case "stats":
        return h("div#stats", statsView());
      case "thanks":
        return h("div#main-wrap", h("h2", _("Thank you for your support!")));
      default:
        return h("div#main-wrap", [h("main.lobby", lobbyView(model2))]);
    }
  }
  function start4() {
    const placeholder = document.getElementById("placeholder");
    if (placeholder && el)
      if (["round", "analysis", "puzzle", "editor", "tv", "embed", "paste"].includes(el.getAttribute("data-view") ?? "")) {
        console.time("load ffish");
        if (model["variant"] === "alice") {
          ffish_alice_default().then((loadedModule) => {
            console.timeEnd("load ffish_alice");
            loadedModule.loadVariantConfig(variantsIni);
            model.ffish = loadedModule;
            patch(placeholder, view(el, model));
          });
        } else {
          ffish_default().then((loadedModule) => {
            console.timeEnd("load ffish");
            loadedModule.loadVariantConfig(variantsIni);
            model.ffish = loadedModule;
            patch(placeholder, view(el, model));
          });
        }
      } else {
        patch(placeholder, view(el, model));
      }
    if (model["embed"]) return;
    document.querySelector(".hamburger").addEventListener(
      "click",
      () => {
        document.querySelectorAll(".topnav a").forEach((nav) => nav.classList.toggle("navbar-show"));
        document.querySelector(".hamburger").classList.toggle("is-active");
      }
    );
    renderTimeago();
    const searchIcon = document.querySelector(".search-icon");
    const searchBar = document.querySelector(".search-bar");
    const searchInput = document.querySelector("#search-input");
    searchIcon.onclick = function() {
      searchBar.classList.toggle("active");
      if (searchBar.classList.contains("active"))
        setTimeout(() => searchInput.focus(), 200);
    };
    function showResults(val) {
      const acResult = document.getElementById("ac-result");
      if (val.length < 4) {
        acResult.innerHTML = "";
        return;
      }
      fetch("/api/names?p=" + val).then((res) => res.json()).then((data) => {
        const list = data.map((el2) => {
          const title = el2[1] ? `<player-title>${el2[1]} </player-title>` : "";
          return `<li><a class="user-link" href="${model["home"]}/@/${el2[0]}">${title}${el2[0]}</a></li>`;
        });
        acResult.innerHTML = '<ul class="box">' + list.join("") + "</ul>";
      }).catch(
        (err) => {
          console.warn("Something went wrong.", err);
        }
      );
    }
    searchInput.addEventListener("keyup", function(e3) {
      showResults(searchInput.value);
      if (e3.keyCode === 13) {
        window.location.href = `${model["home"]}/@/${searchInput.value}`;
      }
    });
    const settingsPanel = patch(document.getElementById("settings-panel"), settingsView(model["variant"])).elm;
    var notifyPanel = document.getElementById("notify-panel");
    if (model["anon"] !== "True") {
      notifyPanel = patch(notifyPanel, notifyView()).elm;
    }
    document.addEventListener("click", function(event) {
      if (!settingsPanel.contains(event.target))
        hideSettings();
      if (model["anon"] !== "True") {
        if (!notifyPanel.contains(event.target))
          hideNotify();
      }
    });
    patch(document.getElementById("zen-button"), zenButtonView()).elm;
  }
  window.addEventListener("resize", () => document.body.dispatchEvent(new Event("chessground.resize")));
  zenModeSettings.update();
  var el = document.getElementById("pychess-variants");
  var model = el ? initModel(el) : initModel(new HTMLElement());
  if (el instanceof Element) {
    soundThemeSettings.assetURL = model.assetURL;
    soundThemeSettings.update();
    volumeSettings.update();
    const lang = el.getAttribute("data-lang") ?? "en";
    fetch(model.assetURL + "/lang/" + lang + "/LC_MESSAGES/client.json").then((res) => res.json()).then((translation) => {
      i18n2.loadJSON(translation, "messages");
      i18n2.setLocale(lang ?? "en");
      start4();
    }).catch((error) => {
      console.error("Could not load translations for lang", lang);
      console.error(error);
      i18n2.setLocale("");
      start4();
    });
  }

  // client/calendar.ts
  function buildCalendar() {
    const xmlhttp = new XMLHttpRequest();
    const url = "/api/calendar";
    xmlhttp.onreadystatechange = function() {
      if (this.readyState === 4 && this.status === 200) {
        const response = JSON.parse(this.responseText);
        if (!response.length) {
          return;
        }
        for (const i3 in response) {
          const variant2 = response[i3].title.replace("960", "");
          const chess960 = response[i3].title.includes("960");
          response[i3].title = VARIANTS[variant2].displayName(chess960);
        }
        let calendarEl = document.getElementById("fullcalendar");
        let calendar = new Calendar(calendarEl, {
          plugins: [index, index2, index3, index4],
          locales: localesAll,
          headerToolbar: {
            left: "prev,next today",
            center: "title",
            right: "dayGridMonth,timeGridWeek,timeGridDay,listWeek"
          },
          firstDay: 1,
          showNonCurrentDates: false,
          fixedWeekCount: false,
          navLinks: true,
          // can click day/week names to navigate views
          dayMaxEvents: true,
          // allow "more" link when too many events
          nextDayThreshold: "06:00:00",
          // events only considered to take up the next day if it ends after this time
          events: response
        });
        let locale = "en";
        const el2 = document.getElementById("pychess-variants");
        if (el2) {
          const lang = el2.getAttribute("data-lang");
          if (calendar.getAvailableLocaleCodes().includes(lang)) locale = lang;
          if (lang === "zh") locale = "zh-cn";
        }
        calendar.setOption("locale", locale);
        calendar.render();
      }
    };
    xmlhttp.open("GET", url, true);
    xmlhttp.send();
  }
  function calendarView() {
    return [
      h("div#fullcalendar.box", { hook: { insert: () => buildCalendar() } })
    ];
  }

  // client/kif.ts
  function l2d(c3) {
    switch (c3) {
      case "a":
        return "9";
      case "b":
        return "8";
      case "c":
        return "7";
      case "d":
        return "6";
      case "e":
        return "5";
      case "f":
        return "4";
      case "g":
        return "3";
      case "h":
        return "2";
      case "i":
        return "1";
      default:
        return "_";
    }
  }
  function d2l(c3) {
    switch (c3) {
      case "1":
        return "i";
      case "2":
        return "h";
      case "3":
        return "g";
      case "4":
        return "f";
      case "5":
        return "e";
      case "6":
        return "d";
      case "7":
        return "c";
      case "8":
        return "b";
      case "9":
        return "a";
      default:
        return "_";
    }
  }
  function mirror(p3) {
    return d2l(p3[0]) + l2d(p3[1]);
  }
  var dict = (keys, values) => keys.reduce((obj, key, index5) => ({ ...obj, [key]: values[index5] }), {});
  var HC_TYPES = ["\u9999\u843D\u3061", "\u53F3\u9999\u843D\u3061", "\u89D2\u843D\u3061", "\u98DB\u8ECA\u843D\u3061", "\u98DB\u9999\u843D\u3061", "\u4E8C\u679A\u843D\u3061", "\u4E09\u679A\u843D\u3061", "\u56DB\u679A\u843D\u3061", "\u4E94\u679A\u843D\u3061", "\u5DE6\u4E94\u679A\u843D\u3061", "\u516D\u679A\u843D\u3061", "\u516B\u679A\u843D\u3061", "\u5341\u679A\u843D\u3061", "\u305D\u306E\u4ED6"];
  var HC_NAMES = ["Lance HC", "RLance HC", "Bishop HC", "Rook HC", "Rook+Lance HC", "2-Piece HC", "3-Piece HC", "4-Piece HC", "5-Piece HC", "LL 5-Piece HC", "6-Piece HC", "8-Piece HC", "10-Piece HC", "Other-HC"];
  var hc_map = dict(HC_TYPES, HC_NAMES);
  var alpha = "abcdefghi".split("");
  var zensuji = "\uFF11\uFF12\uFF13\uFF14\uFF15\uFF16\uFF17\uFF18\uFF19".split("");
  var kansuji = "\u4E00\u4E8C\u4E09\u56DB\u4E94\u516D\u4E03\u516B\u4E5D".split("");
  var zen_map = dict(zensuji, ["1", "2", "3", "4", "5", "6", "7", "8", "9"]);
  var kan_map = dict(kansuji, alpha);
  var pieces = "\u6B69\u9999\u6842\u9280\u91D1\u89D2\u98DB\u7389\u3068\u99AC\u9F8D\u7ADC";
  var piece_map = dict("\u6B69\u9999\u6842\u9280\u91D1\u89D2\u98DB\u7389\u3068\u99AC\u9F8D\u7ADC".split(""), "PLNSGBRK".split("").concat(["+P", "+B", "+R", "+R"]));
  var line_re = /(\d+) +([^ ]+)/u;
  function resultString(movingPlayerWin, ply, isHandicap2) {
    if (ply % 2 === (movingPlayerWin ? 1 : 0)) {
      return !isHandicap2 ? "1-0" : "0-1";
    } else {
      return !isHandicap2 ? "0-1" : "1-0";
    }
  }
  function parseKif(text) {
    let date = "", place = "", tc = "", sente = "", gote = "", handicap = "";
    let status2 = 11;
    let result3 = "*";
    const move_list = [];
    let tagsProcessed = false;
    let isHandicap2 = false;
    let movesStartLineNumber = 0, ply;
    const lines = text.split(/\r?\n/u);
    let piace_name, prev_position, next_position = "", rest;
    const WIN = true;
    const LOSS = false;
    for (let i3 = 0; i3 < lines.length; i3++) {
      const firstChar = lines[i3][0];
      if (firstChar === "#" || firstChar === "*") continue;
      if (!tagsProcessed) {
        const symbols = [...lines[i3]];
        const idx = symbols.indexOf("\uFF1A");
        if (idx > -1) {
          const tagPair = [symbols.slice(0, idx).join(""), symbols.slice(idx + 1).join("")];
          switch (tagPair[0]) {
            case "\u958B\u59CB\u65E5\u6642":
              date = tagPair[1];
              break;
            case "\u5834\u6240":
              place = tagPair[1];
              break;
            case "\u6301\u3061\u6642\u9593":
              tc = tagPair[1];
              break;
            case "\u624B\u5408\u5272":
              handicap = tagPair[1];
              isHandicap2 = HC_TYPES.includes(handicap);
              handicap = isHandicap2 ? hc_map[handicap] : "";
              break;
            case "\u5148\u624B":
              sente = tagPair[1];
              break;
            case "\u5F8C\u624B":
              gote = tagPair[1];
              break;
          }
        } else {
          tagsProcessed = true;
        }
      }

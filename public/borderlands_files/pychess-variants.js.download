  // client/notifyView.ts
  function result(win) {
    switch (win) {
      case true:
        return "Congratulations, you won!";
        break;
      case false:
        return "Defeat";
        break;
      default:
        return "Draw";
    }
  }
  function messageView(message) {
    const read2 = message.read ? "" : ".new";
    const content = message.content;
    switch (message.type) {
      case "gameAborted":
        return h(`div.notification.corr${read2}`, [
          h("div.icon.icon-paper-plane"),
          h("span.content", [
            h("span", [
              h("strong", "Game vs " + content.opp),
              h("info.date", { attrs: { timestamp: message.createdAt } }, timeago(message.createdAt))
            ]),
            h("span", "Game aborted")
          ])
        ]);
      case "gameEnd":
        return h(`a.notification.corr${read2}`, { attrs: { href: "/" + content.id } }, [
          h("div.icon.icon-paper-plane"),
          h("span.content", [
            h("span", [
              h("strong", "Game vs " + content.opp),
              h("info.date", { attrs: { timestamp: message.createdAt } }, timeago(message.createdAt))
            ]),
            h("span", result(content.win))
          ])
        ]);
      case "corrAlarm":
        return h(`a.notification.corr${read2}`, { attrs: { href: "/" + content.id } }, [
          h("div.icon.icon-paper-plane"),
          h("span.content", [
            h("span", [
              h("strong", "Time is almost up!"),
              h("info.date", { attrs: { timestamp: message.createdAt } }, timeago(message.createdAt))
            ]),
            h("span", "Game vs " + content.opp)
          ])
        ]);
      default:
        return "";
    }
  }
  function compareMessages(a3, b3) {
    if (a3.createdAt < b3.createdAt) return 1;
    if (a3.createdAt > b3.createdAt) return -1;
    return 0;
  }
  function renderMessages(messages) {
    let renderedMessages = [];
    if (messages.length === 0) {
      renderedMessages.push(
        h("span.notification.empty", [
          h("div.icon.icon-info", "\u{1F6C8}"),
          h("span.text", _("No notifications."))
        ])
      );
    } else {
      messages.sort(compareMessages).forEach((message) => renderedMessages.push(messageView(message)));
    }
    return renderedMessages;
  }
  function notifyView() {
    var page = 0;
    var unread = 0;
    var messages = [];
    const xmlhttp = new XMLHttpRequest();
    const url = "/notifications?p=";
    var notifyAppEl;
    const newNotifyCounter = (sum, message) => sum + (message.read ? 0 : 1);
    function redraw() {
      document.querySelector(".data-count").setAttribute("data-count", `${unread}`);
      notifyAppEl = patch(notifyAppEl, h("div#notify-app", renderMessages(messages)));
    }
    xmlhttp.onreadystatechange = function() {
      if (this.readyState === 4 && this.status === 200) {
        notifyAppEl = document.getElementById("notify-app");
        messages = JSON.parse(this.responseText);
        unread = messages.reduce(newNotifyCounter, 0);
        redraw();
        const evtSource = new EventSource("/notify");
        evtSource.onmessage = function(event) {
          messages = JSON.parse(event.data);
          unread = messages.reduce(newNotifyCounter, 0);
          page = 0;
          redraw();
        };
      }
    };
    xmlhttp.open("GET", `${url}${page}`, true);
    xmlhttp.send();
    function sendNotified() {
      const xmlhttp2 = new XMLHttpRequest();
      xmlhttp2.onreadystatechange = function() {
        if (this.readyState === 4 && this.status === 200) {
          console.log("sendNotified() was OK");
        }
      };
      xmlhttp2.open("GET", "/notified", true);
      xmlhttp2.send();
    }
    function showNotify() {
      if (unread > 0) {
        messages.forEach((msg) => msg.read = true);
        unread = 0;
        document.querySelector(".data-count").setAttribute("data-count", `${unread}`);
        sendNotified();
      } else {
        document.querySelectorAll(".notification.new").forEach((el2) => el2.classList.remove("new"));
      }
      document.getElementById("btn-notify").classList.add("shown");
      document.getElementById("notify-app").style.display = "flex";
    }
    function toggleNotify() {
      if (document.getElementById("notify-app").style.display === "flex") {
        hideNotify();
      } else {
        showNotify();
      }
    }
    return h("div#notify-panel", [
      h("button#btn-notify", { on: { click: toggleNotify }, attrs: { "aria-label": `Notifications: ${unread}` } }, [
        h("div.icon.icon-bell-o.data-count", { attrs: { "data-count": 0 } })
      ]),
      h("div#notify-app")
    ]);
  }
  function hideNotify() {
    document.getElementById("btn-notify").classList.remove("shown");
    document.getElementById("notify-app").style.display = "none";
  }


      url: `${ws}://${location.host}/${target}`,
      pingTimeout: 2500,
      pongTimeout: 9e3,
      reconnectTimeout: 4e3,
      pingMsg: "/n"
    };
    const socket = new WebsocketHeartbeatJs(options);
    window.addEventListener("beforeunload", () => socket.close());

        "div.auto-next-toggle",
        toggleSwitch(
          this,
          "auto-next",
          _("Jump to next puzzle immediately"),
          false
        )
      );
    }
  };

  // client/puzzleCtrl.ts
  var PuzzleController = class extends AnalysisController {
    constructor(el2, model2) {
      super(el2, model2);
      this.moves = [];
      this.cgConfig = (move3) => {
        this.fullfen = this.ffishBoard.fen(this.variant.ui.showPromoted, 0);
        this.turnColor = this.fullfen.split(" ")[1] === "w" ? "white" : "black";
        return {
          fen: this.fullfen,
          turnColor: this.turnColor,
          movable: {
            color: this.turnColor
          },
          check: this.ffishBoard.isCheck(),
          lastMove: uci2LastMove(move3),
          drawable: { autoShapes: [] }
        };
      };
      const data = JSON.parse(model2.puzzle);
      this._id = data._id;
      this.gameId = data.gameId;
      this.site = data.site;
      this.played = data.played ?? "0";
      this.puzzleType = data.type;
      this.puzzleEval = data.eval;
      this.solution = model2.variant === "duck" ? data.moves.match(/[^,]+,[^,]+/g) : data.moves.split(",");
      this.username = model2.username;
      this.moves = [];
      this.steps = [{ "fen": this.fullfen, "turnColor": this.turnColor, "check": false, "move": void 0 }];
      this.ply = 0;
      this.plyVari = 0;
      this.color = this.turnColor;
      this.failed = false;
      this.completed = false;
      this.posted = false;
      this.wrating = model2.wrating;
      this.brating = model2.brating;
      this.isRated = localStorage.puzzle_rated === void 0 ? true : localStorage.puzzle_rated === "true";
      this.autoNext = localStorage.puzzle_autoNext === void 0 ? false : localStorage.puzzle_autoNext === "true";
      this.localAnalysis = false;
      const lm = data.lm ? data.lm : lmBeforeEp(this.variant, this.fullfen);
      this.chessground.set({
        orientation: this.variant.name === "racingkings" ? "white" : this.turnColor,
        turnColor: this.turnColor,
        lastMove: uci2LastMove(lm),
        movable: {
          free: false,
          color: this.turnColor,
          events: {
            after: (orig, dest, meta) => this.onUserMove(orig, dest, meta),
            afterNewPiece: (role, dest, meta) => this.onUserDrop(role, dest, meta)
          }
        },
        events: {
          move: this.onMove(),
          dropNewPiece: this.onDrop(),
          select: this.onSelect()
        }
      });
      const rt = document.querySelector(".rated-toggle");
      if (this.anon) {
        patch(rt, h("div", [
          h("div", "To solve the puzzles rated"),
          h(
            "button.join",
            { on: { click: () => window.location.assign("/login") } },
            _("LOGIN")
          )
        ]));
      } else {
        const ratedSettings = new RatedSettings(this);
        patch(rt, ratedSettings.view());
        this.renderRating(this.isRated, this.color, this.wrating, this.brating);
      }
      const autoNextSettings = new AutoNextSettings(this);
      const ant = document.querySelector(".auto-next-toggle");
      patch(ant, autoNextSettings.view());
      this.playerEl = document.querySelector(".player");
      this.yourTurn();
      const gaugeEl = document.getElementById("gauge");
      this.gaugeNeeded = window.getComputedStyle(gaugeEl).display === "block";
      if (this.gaugeNeeded) gaugeEl.style.display = "none";
      const engineEl = document.querySelector(".engine");
      engineEl.style.display = "none";
      const viewHintEl = document.querySelector(".hint");
      patch(
        viewHintEl,
        h(
          "a.button.hint.button-empty",
          { on: { click: () => this.viewHint() } },
          _("Hint")
        )
      );
      const viewSolutionEl = document.querySelector(".solution");
      patch(
        viewSolutionEl,
        h(
          "a.button.solution.button-empty",
          { on: { click: () => this.viewSolution() } },
          _("View the solution")
        )
      );
      this.renderInfos();
      if (this._id === "0") {
        this.puzzleComplete(false);
        return;
      }
      function showHintAndSolution() {
        const viewHintEl2 = document.querySelector(".view-hint");
        patch(viewHintEl2, h("div.view-hint", { class: { show: true } }));
        const viewSolutionEl2 = document.querySelector(".view-solution");
        patch(viewSolutionEl2, h("div.view-solution", { class: { show: true } }));
      }
      setTimeout(showHintAndSolution, 4e3);
    }
    renderRating(isRated, color, wrating, brating, success = void 0, diff4 = void 0) {
      if (isRated) {
        var diffEl = "";
        if (diff4) {
          if (success) {
            diffEl = h("good.rp", [h("span", { attrs: { "data-icon": "\u2B08" } }, " "), "+" + diff4]);
          } else {
            diffEl = h("bad.rp", [h("span", { attrs: { "data-icon": "\u2B0A" } }, " "), diff4]);
          }
        }
        const ratingEl = document.querySelector(".rating");
        patch(ratingEl, h(`div.rating.${diff4 ? "final" : "rated"}`, [
          h("strong", [
            color === "white" ? wrating : brating,
            diffEl
          ])
        ]));
      } else {
        const ratingEl = document.querySelector(".rating");
        patch(
          ratingEl,
          h(
            "div.rating.casual",
            _("Your puzzle rating will not change. Note that puzzles are not a competition. Ratings help select the best puzzles for your current skill.")
          )
        );
      }
    }
    renderInfos() {
      var sourceLink = this.home + "/" + this.gameId;
      var sourceText = this.gameId;
      if (!this.gameId) {
        if (!this.site || this.site.toLowerCase().includes("fairy-stockfish")) {
          sourceLink = "https://fairy-stockfish.github.io";
          sourceText = "Fairy-Stockfish";
        } else {
          sourceLink = this.site;
          const url = new URL(this.site);
          sourceText = url.hostname.replace("www.", "");
        }
      }
      var mateIn = "";
      if (this.puzzleType === "mate") {
        const parts = this.puzzleEval.split("#");
        if (parseInt(parts[1]) * 2 - 1 === this.solution.length) {
          mateIn = " #" + parts[1];
        }
      }
      if (sourceLink === "https://syougi.qinoa.com/ja/") {
        this.puzzleType = "tsume";
      }
      const infosEl = document.querySelector(".infos");
      patch(infosEl, h("div.game-info", [
        h("section", [
          h("div.info0.icon.icon-puzzle", [
            h("div.info2", [
              h("div", [h("span", _("Puzzle")), h("a", { attrs: { href: `/puzzle/${this._id}` } }, `#${this._id}`)]),
              h("div", [h("span", _("Rating:")), h("span.hidden", _("hidden"))]),
              h("div", [h("span", _("Played:")), this.played])
            ])
          ])
        ]),
        h("div.info0.icon", { attrs: { "data-icon": this.variant.icon() } }, [
          h("div.info2", [
            h("div", [
              h("span", _("Variant")),
              h(
                "a",
                {
                  attrs: {
                    target: "_blank",
                    href: "/variants/" + this.variant.name
                  }
                },
                this.variant.displayName()
              )
            ]),
            h("div", [
              h("span", _("Source:")),
              h("a", { attrs: { href: sourceLink } }, sourceText)
            ]),
            h("div", [
              h("span", _("Type:")),
              this.puzzleType + mateIn
            ])
          ])
        ])
      ]));
    }
    viewSolution() {
      this.solution.slice(this.ply).forEach((move3) => this.makeMove(move3));
      this.puzzleComplete(false);
    }
    viewHint() {
      this.failed = true;
      const pv_move = uci2cg(this.solution[this.ply]);
      const shapes0 = this.shapeFromMove(pv_move, this.turnColor);
      this.chessground.set({
        drawable: { autoShapes: shapes0 }
      });
    }
    doSendMove(move3) {
      if (this.completed) {
        super.doSendMove(move3);
        return;
      }
      if (this.solution[this.ply] !== move3) {
        if (this.moves.length + 1 === this.solution.length) {
          this.ffishBoard.push(move3);
          const win_result = this.turnColor === "white" ? "1-0" : "0-1";
          if (this.ffishBoard.result() === win_result) {
            this.ffishBoard.pop();
            this.makeMove(move3);
            this.puzzleComplete(true);
            return;
          } else {
            this.ffishBoard.pop();
          }
          ;
        }
        ;
        this.goPly(this.ply);
        this.ffishBoard.setFen(this.fullfen);
        this.setDests();
        const san = this.ffishBoard.sanMove(move3, this.notationAsObject);
        this.notTheMove(san);
        return;
      }
      this.makeMove(move3);
      if (this.moves.length < this.solution.length) {
        this.makeMove(this.solution[this.ply]);
        this.bestMove();
      } else {
        this.puzzleComplete(true);
      }
    }
    makeMove(move3) {
      const san = this.ffishBoard.sanMove(move3, this.notationAsObject);
      this.moves.push(move3);
      this.ffishBoard.push(move3);
      this.chessground.set(this.cgConfig(move3));
      this.setDests();
      const step2 = {
        "fen": this.fullfen,
        "move": move3,
        "check": this.ffishBoard.isCheck(),
        "turnColor": this.turnColor,
        "san": san
      };
      this.steps.push(step2);
      this.ply += 1;
      updateMovelist2(this);
      if (this.variant.ui.materialPoint) {
        [this.vmiscInfoW, this.vmiscInfoB] = updatePoint(this.variant, this.ffishBoard.fen(), this.vmiscInfoW, this.vmiscInfoB);
      }
    }
    yourTurn() {
      const turnColor = this.fullfen.split(" ")[1];
      const pieceColor = turnColor == "w" ? "white" : "black";
      const kingRole = this.variant.kingRoles[0];
      const first = _(this.variant.colors.first);
      const second = _(this.variant.colors.second);
      this.playerEl = patch(
        this.playerEl,
        h(`div.player.${this.variant.pieceFamily}`, [
          h(`piece.${pieceColor}.no-square.${kingRole}.ally`),
          h("div.instruction", [
            h("strong", _("Your turn")),
            h("em", _("Find the best move for %1.", turnColor === "w" ? first : second))
          ])
        ])
      );
    }
    notTheMove(san) {
      if (!this.failed) {
        this.postSuccess(false);
      }
      this.failed = true;
      this.playerEl = patch(
        this.playerEl,
        h("div.player", [
          h("div.icon", "\u2717"),
          h("div.instruction", [
            h("san", [san, h("span.fail", "?")]),
            h("strong", _("That's not the move!")),
            h("em", _("Try something else."))
          ])
        ])
      );
      const feedbackEl = document.querySelector(".feedback");
      feedbackEl.classList.toggle("good", false);
      feedbackEl.classList.toggle("fail", true);
    }
    bestMove() {
      this.playerEl = patch(
        this.playerEl,
        h("div.player", [
          h("div.icon", "\u2713"),
          h("div.instruction", [
            h("strong", _("Best move!")),
            h("em", _("Keep going..."))
          ])
        ])
      );
      const feedbackEl = document.querySelector(".feedback");
      feedbackEl.classList.toggle("fail", false);
      feedbackEl.classList.toggle("good", true);
    }
    puzzleComplete(success) {
      var text = "";
      if (!this.failed && success) {
        text = _("Success!");
        this.postSuccess(true);
      } else if (!success) {
        if (this._id !== "0") {
          text = _("Puzzle complete!");
          this.postSuccess(false);
        } else {
          text = _("We have no more puzzles for this variant.");
        }
      }
      this.completed = true;
      const feedbackEl = document.querySelector(".feedback");
      patch(
        feedbackEl,
        h("div.feedback.after", [
          h("div.complete", text),
          h("div.puzzle_vote", [
            h("div.puzzle_vote_help", [
              h("p", _("Did you like this puzzle?")),
              h("p", _("Vote to load the next one!"))
            ]),
            h("div.puzzle_vote_buttons.enabled", [
              h(
                "div.vote.vote-up.icon.icon-thumbs-o-up",
                { on: { click: () => this.postVote(true) } }
              ),
              h(
                "div.vote.vote-down.icon.icon-thumbs-o-up",
                { on: { click: () => this.postVote(false) } }
              )
            ])
          ]),
          h("div.more", [
            h(
              "a",
              { on: { click: () => this.continueTraining(this.variant.name) } },
              _("Continue training")
            )
          ])
        ])
      );
      if (this.gaugeNeeded) {
        const gaugeEl = document.getElementById("gauge");
        gaugeEl.style.display = "block";
      }
      const engineEl = document.querySelector(".engine");
      engineEl.style.display = "flex";
      const settingsEl = document.getElementById("bars");
      settingsEl.style.display = "block";
      if (this.autoNext && success) {
        this.continueTraining(this.variant.name);
      } else {
        this.localAnalysis = localStorage.localAnalysis === void 0 ? false : localStorage.localAnalysis === "true";
      }
    }
    continueTraining(variant2) {
      let loc = location.href;
      if (!loc.endsWith("/puzzle")) {
        const parts = loc.split("/");
        const tail = parts[parts.length - 1];
        if (!variants.includes(tail)) {
          loc = "/puzzle/" + variant2;
        }
      }
      window.location.assign(loc);
    }
    postVote(vote) {
      const XHR = new XMLHttpRequest();
      const FD = new FormData();
      FD.append("vote", `${vote}`);
      const continueTraining = this.continueTraining;
      const variant2 = this.variant.name;
      XHR.onreadystatechange = function() {
        if (this.readyState === 4 && this.status === 200) {
          const response = JSON.parse(this.responseText);
          if (response["error"] !== void 0) {
            console.log(response["error"]);
          } else {
            continueTraining(variant2);
          }
        }
      };
      XHR.open("POST", `/puzzle/vote/${this._id}`, true);
      XHR.send(FD);
    }
    postSuccess(success) {
      if (this.posted) return;
      this.posted = true;
      const XHR = new XMLHttpRequest();
      const FD = new FormData();
      FD.append("win", `${success}`);
      FD.append("variant", this.variant.name);
      FD.append("color", this.color);
      FD.append("rated", `${this.isRated}`);
      const isRated = this.isRated;
      const color = this.color;
      const wrating = this.wrating;
      const brating = this.brating;
      const renderRating = this.renderRating;
      XHR.onreadystatechange = function() {
        if (this.readyState === 4 && this.status === 200) {
          const response = JSON.parse(this.responseText);
          if (response["error"] !== void 0) {
            console.log(response["error"]);
          } else {
            patch(document.getElementById("puzzle-rated"), h("input#puzzle-rated", { attrs: { disabled: true } }));
            if (isRated) {
              const hiddenEl = document.querySelector(".hidden");
              patch(hiddenEl, h("span.hidden", color === "white" ? brating : wrating));
              const diff4 = response[color === "white" ? 0 : 1];
              renderRating(isRated, color, wrating, brating, success, diff4);
            }
          }
        }
      };
      XHR.open("POST", `/puzzle/complete/${this._id}`, true);
      XHR.send(FD);
    }
  };

  // client/puzzle.ts
  function runPuzzle(vnode2, model2) {
    const el2 = vnode2.elm;
    const ctrl = new PuzzleController(el2, model2);
    window["onFSFline"] = ctrl.onFSFline;
  }
  function leftSide2(model2) {
    const setVariant = (isInput) => {
      let e3;
      e3 = document.getElementById("variant");
      const variant2 = e3.options[e3.selectedIndex].value;
      if (isInput) window.location.assign("/puzzle/" + variant2);
    };
    return h("div", [
      h("div.puzzle-meta", [
        h("div.infos")
      ]),
      h("div.puzzle-user", [
        h("div.rated-toggle"),
        h("div.rating")
      ]),
      h("div.puzzle-info", [
        h("label", { attrs: { for: "variant" } }, _("Variant")),
        selectVariant("variant", model2.variant, () => setVariant(true), () => setVariant(false), noPuzzleVariants),
        h("div.auto-next-toggle")
      ])
    ]);
  }
  function puzzleView(model2) {
    const variant2 = VARIANTS[model2.variant];
    return [
      h("div.analysis-app", [
        h("aside.sidebar-first", leftSide2(model2)),
        h(`selection#mainboard.${variant2.boardFamily}.${variant2.pieceFamily}.${variant2.ui.boardMark}`, [
          h("div.cg-wrap." + variant2.board.cg, { hook: { insert: (vnode2) => runPuzzle(vnode2, model2) } })
        ]),
        gauge(),
        h("div.pocket-top", [
          h("div." + variant2.pieceFamily + "." + model2["variant"], [
            h("div.cg-wrap.pocket", [
              h("div#pocket0")
            ])
          ])
        ]),
        analysisTools(),
        analysisSettings.view(variant2.name),
        h("div#move-controls"),
        h("div.pocket-bot", [
          h("div." + variant2.pieceFamily + "." + model2["variant"], [
            h("div.cg-wrap.pocket", [
              h("div#pocket1")
            ])
          ])
        ]),
        h("under-left#spectators"),
        h("under-board")
      ])
    ];
  }

  // client/bug/profile.bug.ts
  function renderGameBoardsBug(game, username) {
    const variant2 = VARIANTS[game.v];
    const [fenA, fenB] = game["f"].split(" | ");
    const orientation = determineOrientation(game, username);
    return [
      h(
        `selection.${variant2.boardFamily}.${variant2.pieceFamily}`,
        { style: { "padding-right": "10px" } },
        h(`div.cg-wrap.${variant2.board.cg}.mini`, {
          hook: {
            insert: (vnode2) => Chessground(vnode2.elm, {
              coordinates: false,
              viewOnly: true,
              fen: fenA,
              lastMove: uci2LastMove(game.lm),
              dimensions: variant2.board.dimensions,
              pocketRoles: variant2.pocket?.roles,
              orientation: orientation[0]
            })
          }
        })
      ),
      h(
        `selection.${variant2.boardFamily}.${variant2.pieceFamily}`,
        h(`div.cg-wrap.${variant2.board.cg}.mini`, {
          hook: {
            insert: (vnode2) => Chessground(vnode2.elm, {
              coordinates: false,
              viewOnly: true,
              fen: fenB,
              lastMove: uci2LastMove(game.lmB),
              dimensions: variant2.board.dimensions,
              pocketRoles: variant2.pocket?.roles,
              orientation: orientation[1]
            })
          }
        })
      )
    ];
  }
  function renderBugTeamInfo(game, team) {
    const [player1, player2] = team === 0 ? [game["us"][0], game["us"][3]] : [game["us"][2], game["us"][1]];
    const [title1, title2] = team === 0 ? [game["wt"], game["btB"]] : [game["wtB"], game["bt"]];
    return [
      h("a.user-link", { attrs: { href: "/@/" + player1 } }, [
        h("player-title", " " + title1 + " "),
        player1
      ]),
      h("div", "+"),
      h("a.user-link", { attrs: { href: "/@/" + player2 } }, [
        h("player-title", " " + title2 + " "),
        player2
      ])
      /*h('br'),
      (game["wb"] === true) ? h('icon.icon-berserk') : '',
      (game["p0"] === undefined) ? "": game["p0"]["e"] + " ",
      (game["p0"] === undefined) ? "": renderRdiff(game["p0"]["d"]), */
    ];
  }
  function determineOrientation(game, username) {
    if (game["us"][0] === username || game["us"][3] === username) {
      return ["white", "black"];
    } else {
      return ["black", "white"];
    }
  }

  // client/profile.ts
  function tournamentInfo(game) {
    let elements = [h("info-date", { attrs: { timestamp: game["d"] } })];
    if (game["tid"]) {
      elements.push(h("span", " \u2022 "));
      elements.push(h("a.icon.icon-trophy", { attrs: { href: "/tournament/" + game["tid"] } }, game["tn"]));
    }
    return elements;
  }
  function renderGames2(model2, games) {
    const rows = games.map((game) => {
      const variant2 = VARIANTS[game.v];
      const chess960 = game.z === 1;
      const tc = timeControlStr(game["b"], game["i"], game["bp"], game["c"] === true ? game["b"] : 0);
      const altStartName = alternateStartName(variant2, game.initialFen);
      const isBug = variant2.twoBoards;
      let teamFirst, teamSecond = "";
      if (isBug) {
        teamFirst = game["us"][0] + "+" + game["us"][3];
        teamSecond = game["us"][2] + "+" + game["us"][1];
      }
      let lastMove, fen;
      [lastMove, fen] = getLastMoveFen(variant2.name, game.lm, game.f);
      return h("tr", [
        h("a", { attrs: { href: "/" + game["_id"] } }, [
          h(
            "td.board",
            { class: { "with-pockets": !!variant2.pocket, "bug": isBug } },
            isBug ? renderGameBoardsBug(game, model2["profileid"]) : [
              h(`selection.${variant2.boardFamily}.${variant2.pieceFamily}.${variant2.ui.boardMark}`, [
                h(`div.cg-wrap.${variant2.board.cg}.mini`, {
                  hook: {
                    insert: (vnode2) => Chessground(vnode2.elm, {
                      coordinates: false,
                      viewOnly: true,
                      fen,
                      lastMove,
                      dimensions: variant2.board.dimensions,
                      pocketRoles: variant2.pocket?.roles
                    })
                  }
                })
              ])
            ]
          ),
          h("td.games-info", [
            h("div.info0.games.icon", { attrs: { "data-icon": variant2.icon(chess960) } }, [
              // h('div.info1.icon', { attrs: { "data-icon": (game["z"] === 1) ? "V" : "" } }),
              h("div.info2", [
                h("div.tc", tc + " \u2022 " + gameType(game["y"]) + " \u2022 " + variant2.displayName(chess960)),
                h("div", altStartName ? altStartName : ""),
                h("div", tournamentInfo(game))
              ])
            ]),
            h("div.info-middle", [
              h(
                "div.versus",
                { class: { "bug": isBug } },
                [
                  h(
                    "player.left",
                    { class: { "bug": isBug } },
                    isBug ? renderBugTeamInfo(game, 0) : [
                      h("a.user-link", { attrs: { href: "/@/" + game["us"][0] } }, [
                        h("player-title", game["wt"] ? " " + game["wt"] + " " : ""),
                        game["us"][0] + aiLevel(game["wt"], game["x"])
                      ]),
                      h("br"),
                      game["wb"] === true ? h("icon.icon-berserk") : "",
                      game["p0"] === void 0 ? "" : game["p0"]["e"] + " ",
                      game["p0"] === void 0 ? "" : renderRdiff(game["p0"]["d"])
                    ]
                  ),
                  h("vs-swords.icon", { attrs: { "data-icon": '"' } }),
                  h(
                    "player.right",
                    { class: { "bug": isBug } },
                    isBug ? renderBugTeamInfo(game, 1) : [
                      h("a.user-link", { attrs: { href: "/@/" + game["us"][1] } }, [
                        h("player-title", game["bt"] ? " " + game["bt"] + " " : ""),
                        game["us"][1] + aiLevel(game["bt"], game["x"])
                      ]),
                      h("br"),
                      game["bb"] === true ? h("icon.icon-berserk") : "",
                      game["p1"] === void 0 ? "" : game["p1"]["e"] + " ",
                      game["p1"] === void 0 ? "" : renderRdiff(game["p1"]["d"])
                    ]
                  )
                ]
              ),
              h(
                "div.info-result",
                {
                  class: {
                    "win": isWinClass(model2, game),
                    "lose": ["1-0", "0-1"].includes(game["r"]) && !isWinClass(model2, game)
                  }
                },
                result2(variant2, game["s"], game["r"], teamFirst, teamSecond)
              )
            ]),
            h("div.info0.games", [
              h("div", [
                h("div.info0", game["m"] === void 0 ? "" : ngettext("%1 move", "%1 moves", game["m"].length)),
                h("div.info0", game["a"] === void 0 ? "" : [h("span.icon", { attrs: { "data-icon": "3" } }), _("Computer analysis available")])
              ])
            ])
          ])
        ])
      ]);
    });
    return [h("tbody", rows)];
  }
  function isWinClass(model2, game) {
    const variant2 = VARIANTS[game.v];
    if (variant2.twoBoards) {
      const team = game["us"][0] === model2["profileid"] || game["us"][3] === model2["profileid"] ? 0 : 1;
      return game["r"] === "1-0" && team === 0 || game["r"] === "0-1" && team === 1;
    } else {
      return game["r"] === "1-0" && game["us"][0] === model2["profileid"] || game["r"] === "0-1" && game["us"][1] === model2["profileid"];
    }
  }
  function loadGames(model2, page) {
    const lang = languageSettings.value;
    const xmlhttp = new XMLHttpRequest();
    let url = "/api/" + model2["profileid"];
    if (model2.level) {
      url = `${url}/loss?l=${lang}&x=8&p=`;
    } else if (model2.variant) {
      url = `${url}/perf/${model2.variant}?l=${lang}&p=`;
    } else if (model2.rated === "1") {
      url = `${url}/rated?l=${lang}&p=`;
    } else if (model2.rated === "2") {
      url = `${url}/import?l=${lang}&p=`;
    } else if (model2.rated === "-2") {
      url = `${url}/playing?l=${lang}&p=`;
    } else if (model2.rated === "-1") {
      url = `${url}/me?l=${lang}&p=`;
    } else {
      url = `${url}/all?l=${lang}&p=`;
    }
    xmlhttp.onreadystatechange = function() {
      if (this.readyState === 4 && this.status === 200) {
        const response = JSON.parse(this.responseText);
        if (!response.length) {
          return;
        }
        const oldVNode = document.getElementById("games");
        if (oldVNode instanceof Element)
          patch(oldVNode, h("table#games", renderGames2(model2, response)));
        renderTimeago();
      }
    };
    xmlhttp.open("GET", `${url}${page}`, true);
    xmlhttp.send();
  }
  function observeSentinel(vnode2, model2) {
    const sentinel = vnode2.elm;
    let page = 0;
    const options = { root: null, rootMargin: "44px", threshold: 1 };
    const intersectionObserver = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.intersectionRatio > 0)) {
        loadGames(model2, page);
        page += 1;
      }
    }, options);
    intersectionObserver.observe(sentinel);
  }
  function profileView(model2) {
    boardSettings.assetURL = model2.assetURL;
    boardSettings.updateBoardAndPieceStyles();
    const profileId = model2["profileid"];
    const rated = model2["rated"];
    const blockEl = document.getElementById("block");
    if (blockEl !== null) renderBlock("block", profileId);
    const unblockEl = document.getElementById("unblock");
    if (unblockEl !== null) renderUnblock("unblock", profileId);
    let tabs = [];
    tabs.push(h("div.sub-ratings", [h("a", { attrs: { href: "/@/" + profileId }, class: { "active": rated === "None" } }, _("Games"))]));
    if (model2["username"] !== profileId) {
      tabs.push(h("div.sub-ratings", [h("a", { attrs: { href: "/@/" + profileId + "/me" }, class: { "active": rated === "-1" } }, _("Games with you"))]));
    }
    tabs.push(h("div.sub-ratings", [h("a", { attrs: { href: "/@/" + profileId + "/rated" }, class: { "active": rated === "1" } }, pgettext("UsePluralFormIfNeeded", "Rated"))]));
    tabs.push(h("div.sub-ratings", [h("a", { attrs: { href: "/@/" + profileId + "/playing" }, class: { "active": rated === "-2" } }, pgettext("UsePluralFormIfNeeded", "Playing"))]));
    tabs.push(h("div.sub-ratings", [h("a", { attrs: { href: "/@/" + profileId + "/import" }, class: { "active": rated === "2" } }, _("Imported"))]));
    return [
      h("div.filter-tabs", tabs),
      h("table#games"),
      h("div#sentinel", { hook: { insert: (vnode2) => observeSentinel(vnode2, model2) } })
    ];
  }
  function renderBlock(id, profileId) {
    const el2 = document.getElementById(id);
    if (el2 !== null) {
      patch(el2, h(
        "a#block.icon.icon-ban",
        {
          attrs: { href: "/api/" + profileId + "/block", title: _("Block") },
          on: { click: (e3) => postBlock(e3, profileId, true) }
        },
        _("Block")
      ));
    }
  }
  function renderUnblock(id, profileId) {
    const el2 = document.getElementById(id);
    if (el2 !== null) {
      patch(el2, h(
        "a#unblock.icon.icon-ban",
        {
          attrs: { href: "/api/" + profileId + "/block", title: _("Unblock") },
          on: { click: (e3) => postBlock(e3, profileId, false) }
        },
        _("Unblock")
      ));
    }
  }
  function postBlock(e3, profileId, block) {
    e3.preventDefault();
    const XHR = new XMLHttpRequest();
    const FD = new FormData();
    FD.append("block", `${block}`);
    XHR.onreadystatechange = function() {
      if (this.readyState === 4 && this.status === 200) {
        const response = JSON.parse(this.responseText);
        if (response["error"] !== void 0) {
          console.log(response["error"]);
        } else {
          if (block) {
            renderUnblock("block", profileId);
          } else {
            renderBlock("unblock", profileId);
          }
        }
      }
    };
    XHR.open("POST", `/api/${profileId}/block`, true);
    XHR.send(FD);
    return false;
  }

  // client/tournamentClock.ts
  var localeOptions = {
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "numeric"
  };
  function getTimeRemaining(endtime) {
    const totalSecs = endtime - Date.now();
    const seconds = Math.floor(totalSecs / 1e3 % 60);
    const minutes = Math.floor(totalSecs / 1e3 / 60 % 60);
    const hours = Math.floor(totalSecs / (1e3 * 60 * 60) % 24);
    const days = Math.floor(totalSecs / (1e3 * 60 * 60 * 24));
    return { totalSecs, days, hours, minutes, seconds };
  }
  function initializeClock(ctrl) {
    if ("finished|archived".includes(ctrl.tournamentStatus)) return;
    let endtime, timeinterval;
    if (ctrl.secondsToFinish > 0) {
      endtime = Date.now() + ctrl.secondsToFinish * 1e3;
      ctrl.clockdiv = patch(ctrl.clockdiv, h("div#clockdiv", [h("span#clock")]));
    } else {
      endtime = Date.now() + ctrl.secondsToStart * 1e3;
      const remaining = getTimeRemaining(endtime);
      if (remaining.days > 0) {
        const startDate = new Date(ctrl.startDate);
        ctrl.clockdiv = patch(ctrl.clockdiv, h("div#clockdiv", [h("info-date", { attrs: { "timestamp": startDate.toLocaleString("default", localeOptions) } })]));
      } else {
        ctrl.clockdiv = patch(ctrl.clockdiv, h("div#clockdiv", [h("span.shy", _("STARTING IN")), h("span#clock")]));
      }
    }
    const clock = document.getElementById("clock");
    function updateClock() {
      const t3 = getTimeRemaining(endtime);
      clock.innerHTML = ("0" + t3.hours).slice(-2) + ":" + ("0" + t3.minutes).slice(-2) + ":" + ("0" + t3.seconds).slice(-2);
      if (t3.totalSecs <= 1e3 && timeinterval !== void 0) {
        clearInterval(timeinterval);
        ctrl.clockdiv = patch(ctrl.clockdiv, h("div#clockdiv"));
      }
    }
    updateClock();
    timeinterval = setInterval(updateClock, 1e3);
  }

  // client/tournament.ts
  var T_STATUS = {
    0: "created",
    1: "started",
    2: "aborted",
    3: "finished",
    4: "archived"
  };
  var scoreTagNames = ["score", "streak", "double"];
  var SCORE_SHIFT = 1e5;
  var SHIELD = "s";
  var TournamentController = class {
    constructor(el2, model2) {
      this.onMsgSpectators = (msg) => {
        const container = document.getElementById("spectators");
        patch(container, h("under-chat#spectators", _("Spectators: ") + msg.spectators));
      };
      this.onMsgBoard = (msg) => {
        if (this.topGameChessground === void 0 || this.topGameId !== msg.gameId) {
          return;
        }
        ;
        let lastMove, fen;
        [lastMove, fen] = getLastMoveFen(this.variant.name, msg.lastMove, msg.fen);
        this.topGameChessground.set({
          fen,
          turnColor: msg.fen.split(" ")[1] === "w" ? "white" : "black",
          check: msg.check,
          lastMove
        });
      };
      this.checkStatus = (msg) => {
        if (this.topGameChessground === void 0 || this.topGameId !== msg.gameId) {
          return;
        }
        console.log(msg);
        if (msg.status >= 0) {
          const result3 = msg.result.split("-");
          patch(document.getElementById("wresult"), h("div#wresult", result3[0]));
          patch(document.getElementById("bresult"), h("div#bresult", result3[1]));
        }
      };
      console.log("TournamentController constructor", el2, model2);
      this.tournamentId = model2["tournamentId"];
      this.nbPlayers = 0;
      this.page = 1;
      this.tournamentStatus = T_STATUS[model2["status"]];
      this.visitedPlayer = "";
      this.startDate = model2["date"];
      this.secondsToStart = 0;
      this.secondsToFinish = 0;
      const onOpen = () => {
        this.doSend({ type: "tournament_user_connected", username: model2["username"], tournamentId: model2["tournamentId"] });
        this.doSend({ type: "get_players", "tournamentId": model2["tournamentId"], page: this.page });
      };
      this.sock = newWebsocket("wst");
      this.sock.onopen = () => onOpen();
      this.sock.onmessage = (e3) => this.onMessage(e3);
      this.variant = VARIANTS[model2["variant"]];
      this.chess960 = model2["chess960"] === "True";
      this.rated = model2["rated"];
      patch(document.getElementById("lobbychat"), chatView(this, "lobbychat"));
      this.buttons = patch(document.getElementById("page-controls"), this.renderButtons());
      this.clockdiv = patch(document.getElementById("clockdiv"), h("div#clockdiv"));
      this.playerGamesOn = false;
      this.vDuels = document.querySelector("div.duels");
      this.username = model2["username"];
      this.anon = model2["anon"] === "True";
      boardSettings.assetURL = model2.assetURL;
      boardSettings.updateBoardAndPieceStyles();
    }
    doSend(message) {
      this.sock.send(JSON.stringify(message));
    }
    goToPage(page) {
      let newPage = page;
      if (page < 1) {
        newPage = 1;
      } else {
        const x4 = Math.floor(this.nbPlayers / 10);
        const y3 = this.nbPlayers % 10;
        const lastPage = x4 + (y3 > 0 ? 1 : 0);
        newPage = page > lastPage ? lastPage : page;
      }
      if (newPage !== this.page) {
        this.page = newPage;
        this.doSend({ type: "get_players", "tournamentId": this.tournamentId, "page": newPage });
      }
    }
    goToMyPage() {
      this.doSend({ type: "my_page", "tournamentId": this.tournamentId });
    }
    login() {
      window.location.assign("/login");
    }
    join() {
      this.doSend({ type: "join", "tournamentId": this.tournamentId });
    }
    pause() {
      this.doSend({ type: "pause", "tournamentId": this.tournamentId });
    }
    withdraw() {
      this.doSend({ type: "withdraw", "tournamentId": this.tournamentId });
    }
    renderButtons() {
      return h("div#page-controls.btn-controls", [
        h("div.pager", [
          h("button", { on: { click: () => this.goToPage(1) } }, [h("i.icon.icon-fast-backward", { props: { title: _("First") } })]),
          h("button", { on: { click: () => this.goToPage(this.page - 1) } }, [h("i.icon.icon-step-backward", { props: { title: _("Prev") } })]),
          // TODO: update
          h("span.page", `${(this.page - 1) * 10 + 1} - ${Math.min(this.page * 10, this.nbPlayers)} / ${this.nbPlayers}`),
          h("button", { on: { click: () => this.goToPage(this.page + 1) } }, [h("i.icon.icon-step-forward", { props: { title: _("Next") } })]),
          h("button", { on: { click: () => this.goToPage(1e4) } }, [h("i.icon.icon-fast-forward", { props: { title: _("Last") } })]),
          h("button", { on: { click: () => this.goToMyPage() } }, [h("i.icon.icon-target", { props: { title: _("Scroll to your player") } })])
        ]),
        h("div#action")
      ]);
    }
    updateActionButton() {
      let button = h("div#action");
      switch (this.tournamentStatus) {
        case "created":
          if (this.userStatus === "joined") {
            button = h("button#action", { on: { click: () => this.withdraw() }, class: { "icon": true, "icon-flag-o": true } }, _("WITHDRAW"));
          } else {
            button = h("button#action", { on: { click: () => this.join() }, class: { "icon": true, "icon-play": true } }, _("JOIN"));
          }
          break;
        case "started":
          if ("spectator|paused|withdrawn".includes(this.userStatus)) {
            button = h("button#action", { on: { click: () => this.join() }, class: { "icon": true, "icon-play": true } }, _("JOIN"));
          } else {
            button = h("button#action", { on: { click: () => this.pause() }, class: { "icon": true, "icon-pause": true } }, _("PAUSE"));
          }
          break;
      }
      if (this.anon && "created|started".includes(this.tournamentStatus)) {
        button = h("button#action", { on: { click: () => this.login() }, class: { "icon": true, "icon-play": true } }, _("LOG IN"));
      }
      this.action = patch(document.getElementById("action"), button);
    }
    completed() {
      return "aborted|finished|archived".includes(this.tournamentStatus);
    }
    renderSummary(msg) {
      const summary = h("div#summary", { class: { "box": true } }, [
        h("h2", _("Tournament complete")),
        h("table", [
          h("tr", [h("th", _("Players")), h("td", msg.nbPlayers)]),
          h("tr", [h("th", _("Average rating")), h("td", Math.round(msg.sumRating / msg.nbPlayers))]),
          h("tr", [h("th", _("Games played")), h("td", msg.nbGames)]),
          h("tr", [h("th", _("%1 wins", _(this.variant.colors.first))), h("td", this.calcRate(msg.nbGames, msg.wWin))]),
          h("tr", [h("th", _("%1 wins", _(this.variant.colors.second))), h("td", this.calcRate(msg.nbGames, msg.bWin))]),
          h("tr", [h("th", _("Draws")), h("td", this.calcRate(msg.nbGames, msg.draw))]),
          h("tr", [h("div", _("Berserk rate")), h("td", this.calcRate(msg.nbGames * 2, msg.berserk))])
        ]),
        h("table.tour-stats-links", [
          h("a.i-dl.icon.icon-download", {
            attrs: {
              href: "/games/export/tournament/" + this.tournamentId,
              download: "pychess_tournament_" + this.tournamentId + ".pgn"
            }

      active.classList.remove("active");
      document.querySelectorAll('move-bug[_ply="' + p3 + '"]').forEach((v3) => v3.setAttribute("style", "display: none;"));
    }
    const elPly = document.querySelector(`move-bug[ply="${ctrl.ply}"]`);
    if (elPly) elPly.classList.add("active");
    document.querySelectorAll('move-bug[_ply="' + ctrl.ply + '"]').forEach((v3) => v3.setAttribute("style", "display: block;"));
  }
  function scrollToPly(ctrl) {

      inc: parseInt("" + el2.getAttribute("data-inc")),
      byo: parseInt("" + el2.getAttribute("data-byo")),
      result: el2.getAttribute("data-result") ?? "",
      status: parseInt("" + el2.getAttribute("data-status")),
      date: el2.getAttribute("data-date") ?? "",
      tv: el2.getAttribute("data-view") === "tv",
      embed: el2.getAttribute("data-view") === "embed",
      seekEmpty: el2.getAttribute("data-seekempty") === "True",

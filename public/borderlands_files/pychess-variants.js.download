      if (this.readyState === 4 && this.status === 200) {
        const response = JSON.parse(this.responseText);
        if (response["gameId"] !== void 0) {
          window.location.assign(home + "/" + response["gameId"]);
        } else if (response["error"] !== void 0) {
          alert(response["error"]);
        }
      }
    };
    XHR.open("POST", "/import_bpgn", true);
    XHR.send(FD);
  }

  // client/paste.ts
  var BRAINKING_SITE = '[Site "BrainKing.com (Prague, Czech Republic)"]';
  var EMBASSY_FEN = '[FEN "rnbqkmcbnr/pppppppppp/10/10/10/10/PPPPPPPPPP/RNBQKMCBNR w KQkq - 0 1"]';
  var BUGHOUSE_VARIANT = "[WhiteA";
  function pasteView(model2) {
    const ffish = model2.ffish;
    const importGame = (model3, ffish2) => {
      const e3 = document.getElementById("pgnpaste");
      let pgn = e3.value;
      if (pgn.indexOf(BUGHOUSE_VARIANT) !== -1) {
        importGameBugH(pgn, model3["home"]);
        return;
      }
      if (pgn.indexOf(BRAINKING_SITE) !== -1 && pgn.indexOf(EMBASSY_FEN) !== -1) {
        const lines = pgn.split(/\n/);
        const fenIndex = lines.findIndex((elem) => {
          return elem.startsWith("[FEN ");
        });
        lines[fenIndex] = `[FEN "${VARIANTS["embassy"].startFen}"]`;
        const variantIndex = lines.findIndex((elem) => {
          return elem.startsWith("[Variant ");
        });
        if (variantIndex < 0) {
          lines.splice(variantIndex, 0, '[Variant "Capablanca"]');
        } else {
          lines.splice(variantIndex, 1, '[Variant "Capablanca"]');
        }
        lines.forEach((line, idx) => {
          if (idx > fenIndex) lines[idx] = line.replace(/(O-O-O|O-O)/g, (match) => {
            return match === "O-O" ? "O-O-O" : "O-O";
          });
        });
        pgn = lines.join("\n");
      }
      if (ffish2 !== null) {
        ffish2.loadVariantConfig(variantsIni);
        const XHR = new XMLHttpRequest();
        const FD = new FormData();
        let variant2, initialFen, board;
        let mainlineMoves = [];
        try {
          const firstLine = pgn.slice(0, pgn.indexOf("\n"));
          if (firstLine.includes("\uFF1A") || firstLine.toUpperCase().includes("KIF")) {
            const kif = parseKif(pgn);
            const handicap = kif["handicap"];
            const moves = kif["moves"];
            let status2 = kif["status"];
            let result3 = kif["result"];
            const as = VARIANTS["shogi"].alternateStart;
            const isHandicap2 = handicap !== "" && as[handicap] !== void 0;
            if (isHandicap2) {
              FD.append("FEN", as[handicap]);
            }
            const fen = isHandicap2 ? as[handicap] : VARIANTS["shogi"].startFen;
            board = new ffish2.Board("shogi", fen);
            let move3;
            for (let idx = 0; idx < moves.length; ++idx) {
              move3 = moves[idx];
              try {
                board.push(move3);
                mainlineMoves.push(move3);
              } catch (err) {
                alert("Illegal move " + move3);
                status2 = 10;
                result3 = resultString(false, idx + 1, isHandicap2);
                break;
              }
            }
            FD.append("Variant", "shogi");
            FD.append("Date", kif["date"]);
            FD.append("White", kif["sente"]);
            FD.append("Black", kif["gote"]);
            FD.append("TimeControl", kif["tc"]);
            FD.append("moves", mainlineMoves.join(" "));
            FD.append("Result", result3);
            FD.append("Status", "" + status2);
            FD.append("final_fen", board.fen());
            FD.append("username", model3["username"]);
            board.delete();
          } else {
            const game = ffish2.readGamePGN(pgn);
            variant2 = "chess";
            const v3 = game.headers("Variant");
            if (v3) variant2 = v3.toLowerCase();
            if (variant2 === "alice") {
              const error = _("Importing Alice PGN is not supported");
              e3.setCustomValidity(error);
              alert(error);
              return;
            }
            initialFen = VARIANTS[variant2].startFen;
            const f3 = game.headers("FEN");
            if (f3) initialFen = f3;
            const t3 = game.headers("Termination");
            if (t3) {
              status = getStatus(t3.toLowerCase());
              FD.append("Status", "" + status);
            }
            const is960 = variant2.includes("960") || variant2.includes("random");
            board = new ffish2.Board(variant2, initialFen, is960);
            mainlineMoves = game.mainlineMoves().split(" ");
            for (let idx = 0; idx < mainlineMoves.length; ++idx) {
              board.push(mainlineMoves[idx]);
            }
            const tags = game.headerKeys().split(" ");
            tags.forEach((tag) => {
              FD.append(tag, game.headers(tag));
            });
            FD.append("moves", game.mainlineMoves());
            FD.append("final_fen", board.fen());
            FD.append("username", model3["username"]);
            board.delete();
            game.delete();
          }
        } catch (err) {
          e3.setCustomValidity(err.message ? _("Invalid PGN") : "");
          alert(err);
          return;
        }
        XHR.onreadystatechange = function() {
          if (this.readyState === 4 && this.status === 200) {
            const response = JSON.parse(this.responseText);
            if (response["gameId"] !== void 0) {
              window.location.assign(model3["home"] + "/" + response["gameId"]);
            } else if (response["error"] !== void 0) {
              alert(response["error"]);
            }
          }
        };
        console.log(FD);
        XHR.open("POST", "/import", true);
        XHR.send(FD);
      }
    };
    return [h("div.paste", [
      h("div.container", [
        h("strong", _("Paste the PGN text here")),
        h("textarea#pgnpaste", { attrs: { spellcheck: "false" } }),
        h("div.import", [
          h("button#import", { on: { click: () => importGame(model2, ffish) } }, [
            h("i", { class: { "icon": true, "icon-cloud-upload": true } }, _("IMPORT GAME"))
          ])
        ])
      ])
    ])];
  }
  function getStatus(termination) {
    if (termination.includes("checkmate")) return "1";
    if (termination.includes("resign")) return "2";
    if (termination.includes("stalemate")) return "3";
    if (termination.includes("draw")) return "5";
    if (termination.includes("repetition")) return "5";
    if (termination.includes("insufficient")) return "5";
    if (termination.includes("time")) return "6";
    if (termination.includes("abandon")) return "7";
    return "11";
  }


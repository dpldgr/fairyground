          move3 = piace_name + prev_position + mirror(next_position) + promote;
        } else {
          move3 = mirror(prev_position) + mirror(next_position) + promote;
        }
        move_list.push(move3);
      }
    }
    return { "date": date, "place": place, "tc": tc, "handicap": handicap, "sente": sente, "gote": gote, "moves": move_list, "status": status2, "result": result3 };
  }

  // client/bug/paste.bug.ts
  function importGameBugH(pgn, home) {

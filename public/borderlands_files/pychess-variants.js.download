        movesStartLineNumber = i3;
        continue;
      }
      const res = lines[i3].match(line_re);
      if (res) {
        const s3 = res[2];
        ply = i3 - movesStartLineNumber - 1;
        if (zensuji.includes(s3[0])) {
          next_position = zen_map[s3[0]] + kan_map[s3[1]];
        } else if (s3[0] === "\u540C") {
        } else if (s3[0] === "\u53CD") {

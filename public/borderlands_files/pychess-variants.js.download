  function initModel(el2) {
    const user = getCookie("user").replace(/(^"|"$)/g, "");
    if (el2.getAttribute("data-dev") !== "True") {
      Object.keys(variantGroups).forEach((g4) => {
        const group = variantGroups[g4];
        devVariants.forEach((v3) => {
          const idx = group.variants.indexOf(v3);
          if (idx > -1) group.variants.splice(idx, 1);
        });
      });
    }
    let ct = el2.getAttribute("data-ct") ?? "";

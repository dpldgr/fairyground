    let board = el2.getAttribute("data-board") ?? "";
    if (board) board = JSON.parse(board);
    return {
      ffish: {},
      home: el2.getAttribute("data-home") ?? "",
      anon: el2.getAttribute("data-anon") ?? "",
      profileid: el2.getAttribute("data-profile") ?? "",
      title: el2.getAttribute("data-title") ?? "",
      variant: el2.getAttribute("data-variant") ?? "",
      chess960: el2.getAttribute("data-chess960") ?? "",
      rated: el2.getAttribute("data-rated") ?? "",
      corr: el2.getAttribute("data-corr") ?? "",

  function result2(variant2, status2, result3, bughouseTeamNameFirst = "", bughouseTeamNameSecond = "") {
    let text = "";
    const variantName = variant2.name;
    const first = _(variant2.colors.first);
    const second = _(variant2.colors.second);
    const loserSingleBoard = result3 === "1-0" ? second : first;
    const loser = bughouseTeamNameFirst !== "" ? result3 === "1-0" ? bughouseTeamNameSecond : bughouseTeamNameFirst : loserSingleBoard;
    const winnerSingleBoard = result3 === "0-1" ? second : first;
    const winner = bughouseTeamNameFirst !== "" ? result3 === "0-1" ? bughouseTeamNameSecond : bughouseTeamNameFirst : winnerSingleBoard;
    switch (status2) {
      case -2:
      case -1:
        text = _("Playing right now");
        break;
      case 0:
        text = _("Game aborted");
        break;
      case 1:
        text = _("Checkmate");
        break;
      case 2:
        text = _("%1 resigned", loser);
        break;
      case 3:
        text = _("Stalemate");
        break;
      case 4:
        text = _("Time out");
        break;
      case 5:
        text = _("Draw");
        break;
      case 6:
        text = _("Time out");
        break;
      case 7:
        text = _("%1 abandoned the game", loser);
        break;
      case 8:
        text = _("Cheat detected");
        break;
      case 9:
        text = _("Not started");
        break;
      case 10:
        text = _("Invalid move");
        break;
      case 11:
        text = _("Unknown reason");
        break;
      case 12:
        switch (variantName) {
          case "orda":
          case "khans":
          case "synochess":
          case "dobutsu":
          case "shinobi":
          case "shinobiplus":
          case "empire":
          case "ordamirror":
            text = _("Campmate");
            break;
          case "chak":
            text = _("Altar mate");
            break;
          case "racingkings":
            text = _("Race finished");
            break;
          case "atomic":
            text = _("Explosion of king");
            break;
          case "kingofthehill":
            text = _("King in the center");
            break;
          case "3check":
            text = _("Three checks");
            break;
          case "duck":
          case "fogofwar":
            text = _("King captured");
            break;
          case "ataxx":
            text = _("Point counting");
            break;
          case "borderlands":
            text = _("Conquest");
            break;
          default:
            text = _("Variant ending");
            break;
        }
        break;
      case 13:
        switch (variantName) {
          case "janggi":
            text = _("Point counting");
            break;
          default:
            text = _("Repetition");
            break;
        }
        break;
      default:
        text = "*";
        break;
    }
    if (status2 <= 0) {
      return text;
    } else {
      if (result3 === "1/2-1/2") {
        if (status2 === 5) {
          return text;
        } else {
          return text + " \u2022 " + _("Draw");
        }
      } else {
        return text + " \u2022 " + _("%1 won", winner);
      }
    }
  }

  // client/bug/movelist.bug.ts
  function selectMove(ctrl, ply, plyVari = 0) {

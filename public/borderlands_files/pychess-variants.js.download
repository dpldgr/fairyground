  function fillWithEmpty(moves, countOfEmptyCellsToAdd, cls = "", ply = "", style = "") {
    for (let i3 = 0; i3 < countOfEmptyCellsToAdd; i3++) {
      moves.push(h("move-bug.counter" + cls, { attrs: { _ply: ply, style } }));
      const el2 = h("move-bug" + cls, { attrs: { _ply: ply, style } });
      moves.push(el2);
    }
  }
  function updateMovelist(ctrl, full = true, activate = true, needResult = true) {
    const plyFrom = full ? 1 : ctrl.steps.length - 1;
    if (plyFrom === 0) return;
    const plyTo = ctrl.steps.length;
    const moves = [];
    const prevPly = ctrl.steps[plyFrom - 1];
    let lastColIdx = plyFrom === 1 ? 0 : prevPly.boardName === "a" ? prevPly.turnColor === "white" ? 2 : 1 : prevPly.turnColor === "white" ? 4 : 3;
    let didWeRenderVariSectionAfterLastMove = false;
    let didWeRenderChatSectionAfterLastMove = false;
    for (let ply = plyFrom; ply < plyTo; ply++) {
      const move3 = ctrl.steps[ply].san;
      if (move3 === null) continue;
      const colIdx = ctrl.steps[ply].boardName === "a" ? ctrl.steps[ply].turnColor === "black" ? 1 : 2 : ctrl.steps[ply].turnColor === "black" ? 3 : 4;
      if (didWeRenderVariSectionAfterLastMove) {
        fillWithEmpty(moves, colIdx - 1);
        didWeRenderVariSectionAfterLastMove = false;
      } else {
        const countOfEmptyCellsToAdd = colIdx > lastColIdx ? colIdx - lastColIdx - 1 : 4 + colIdx - lastColIdx - 1;
        fillWithEmpty(moves, countOfEmptyCellsToAdd);
      }
      if (didWeRenderChatSectionAfterLastMove) {
        fillWithEmpty(moves, lastColIdx, ".ch", "" + (ply - 1), "display: none");
        didWeRenderChatSectionAfterLastMove = false;
      }
      lastColIdx = colIdx;
      const moveEl = [h("san", move3)];
      const scoreStr = ctrl.steps[ply]["scoreStr"] ?? "";
      moveEl.push(h("eval#ply" + ply, scoreStr));
      var chats = void 0;
      if (ctrl.steps[ply].chat) {
        const chatMessages = [];
        for (let x4 of ctrl.steps[ply].chat) {
          const time = formatChatMessageTime(x4);
          const m3 = x4.message.replace("!bug!", "");
          const v3 = h(
            "li.message",
            [
              h("div.time", time),
              h("user", h("a", { attrs: { href: "/@/" + x4.username } }, x4.username)),
              /*h("div.discord-icon-container", h("img.icon-discord-icon", { attrs: { src: '/static/icons/discord.svg' } }))*/
              x4.message.indexOf("!bug") > -1 ? h("div.bugchat." + m3, []) : h("div", [x4.message])
            ]
          );
          chatMessages.push(
            v3
            /*h("div", +" "+x.username+": "+x.message)*/
          );
        }
        chats = h("ol.bugchatpopup.chat", chatMessages);
        didWeRenderChatSectionAfterLastMove = true;
      }
      moves.push(h("move-bug.counter", getLocalMoveNum(ctrl.steps[ply])));
      const el2 = h("move-bug", {
        class: { active: ply === plyTo - 1 && activate, haschat: !!ctrl.steps[ply].chat },
        attrs: { ply },
        on: { click: () => selectMove(ctrl, ply) }
      }, moveEl);
      moves.push(el2);
      if (chats) moves.push(chats);
      if (ctrl.steps[ply]["vari"] !== void 0 && "plyVari" in ctrl) {
        const variMoves = ctrl.steps[ply]["vari"];
        let plyAVari = ctrl.steps[ply].plyA;
        let plyBVari = ctrl.steps[ply].plyB;
        moves.push(h(
          "vari#vari" + ctrl.plyVari,
          variMoves ? variMoves.map((x4, idx) => {
            const currPlyGlobal = ctrl.plyVari + idx;
            const currPlyBoard = x4.boardName === "a" ? ++plyAVari : ++plyBVari;
            const boardName = x4.turnColor === "white" ? x4.boardName : x4.boardName.toUpperCase();
            const moveCounter = Math.floor((currPlyBoard + 1) / 2) + boardName + ". ";
            return h(
              "vari-move",
              {
                attrs: { ply: currPlyGlobal },
                on: { click: () => selectMove(ctrl, ctrl.plyVari + idx, ctrl.plyVari) }
              },
              [h("san", moveCounter + x4["san"])]
            );
          }) : []
        ));
        didWeRenderVariSectionAfterLastMove = true;
      }
    }
    if (ctrl.status >= 0 && needResult) {
      const teamFirst = ctrl.teamFirst[0][0] + "+" + ctrl.teamFirst[1][0];
      const teamSecond = ctrl.teamSecond[0][0] + "+" + ctrl.teamSecond[1][0];
      moves.push(h("div.result", ctrl.result));
      moves.push(h("div.status", result2(ctrl.b1.variant, ctrl.status, ctrl.result, teamFirst, teamSecond)));
    }
    const container = document.getElementById("movelist");
    if (full) {
      while (container.lastChild) {
        container.removeChild(container.lastChild);
      }
    }
    ctrl.vmovelist = patch(container, h("div#movelist", moves));
    if (activate) {
      activatePly(ctrl);
      scrollToPly(ctrl);
    }
  }
  function getLocalMoveNum(step2) {
    return Math.floor(step2.boardName === "a" ? (step2.plyA + 1) / 2 : (step2.plyB + 1) / 2);
  }
  function formatChatMessageTime(x4) {
    const min = Math.floor(x4.time / 6e4);
    const sec = Math.floor((x4.time - min * 6e4) / 1e3);
    const millis = x4.time - min * 6e4 - sec * 1e3;

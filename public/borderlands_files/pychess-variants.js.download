      gameId: el2.getAttribute("data-gameid") ?? "",
      tournamentId: el2.getAttribute("data-tournamentid") ?? "",
      tournamentname: el2.getAttribute("data-tournamentname") ?? "",
      inviter: el2.getAttribute("data-inviter") ?? "",

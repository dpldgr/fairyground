      wtitle: el2.getAttribute("data-wtitle") ?? "",
      wrating: el2.getAttribute("data-wrating") ?? "",
      wrdiff: parseInt("" + el2.getAttribute("data-wrdiff")),
      wberserk: el2.getAttribute("data-wberserk") ?? "",
      bplayer: el2.getAttribute("data-bplayer") ?? "",
      btitle: el2.getAttribute("data-btitle") ?? "",
      brating: el2.getAttribute("data-brating") ?? "",
      brdiff: parseInt("" + el2.getAttribute("data-brdiff")),
      bberserk: el2.getAttribute("data-bberserk") ?? "",
      wplayerB: el2.getAttribute("data-wplayer-b") ?? "",
      wtitleB: el2.getAttribute("data-wtitle-b") ?? "",
      wratingB: el2.getAttribute("data-wrating-b") ?? "",

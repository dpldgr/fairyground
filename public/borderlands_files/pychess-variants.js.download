      this.ctrl = ctrl;
    }
    update() {
      this.ctrl.isRated = this.value;
      this.ctrl.renderRating(this.ctrl.isRated, this.ctrl.color, this.ctrl.wrating, this.ctrl.brating);
    }
    view() {
      return h(
        "div.rated-toggle",
        toggleSwitch(
          this,
          "puzzle-rated",
          _("Rated"),
          false
        )
